{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/SCamposs/void-mind/schemas/model-manifest-v1.json",
  "title": "VOID Mind model manifest",
  "description": "Portable metadata for a VOID Mind GGUF model and its training lineage.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "name",
    "version",
    "base",
    "source",
    "format",
    "quantization",
    "languages",
    "context",
    "chat_template",
    "training_lineage",
    "training_datasets",
    "training_stages",
    "adapters",
    "evaluations",
    "hashes",
    "created_by",
    "created_at"
  ],
  "properties": {
    "schema_version": { "const": "1.0.0" },
    "name": { "type": "string", "minLength": 1, "maxLength": 120 },
    "version": { "type": "string", "pattern": "^A(?:0|[1-9][0-9]*)$" },
    "base": { "type": "string", "minLength": 1, "maxLength": 240 },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["uri", "license"],
      "properties": {
        "uri": { "type": "string", "minLength": 1, "maxLength": 500 },
        "license": { "type": "string", "minLength": 1, "maxLength": 120 }
      }
    },
    "format": { "const": "GGUF" },
    "quantization": { "type": "string", "minLength": 1, "maxLength": 64 },
    "languages": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 2, "maxLength": 35 }
    },
    "context": { "type": "integer", "minimum": 256, "maximum": 1048576 },
    "chat_template": { "type": "string", "minLength": 1, "maxLength": 120 },
    "training_lineage": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "version", "relation"],
        "properties": {
          "name": { "type": "string", "minLength": 1, "maxLength": 120 },
          "version": { "type": "string", "minLength": 1, "maxLength": 80 },
          "relation": {
            "enum": ["base", "fine_tuned_from", "merged_from", "quantized_from"]
          },
          "manifest_sha256": { "type": "string", "pattern": "^[a-fA-F0-9]{64}$" },
          "dataset_refs": {
            "type": "array",
            "uniqueItems": true,
            "items": { "type": "string", "minLength": 1, "maxLength": 240 }
          }
        }
      }
    },
    "training_datasets": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "version", "license"],
        "properties": {
          "name": { "type": "string", "minLength": 1, "maxLength": 160 },
          "version": { "type": "string", "minLength": 1, "maxLength": 80 },
          "license": { "type": "string", "minLength": 1, "maxLength": 120 },
          "sha256": { "type": "string", "pattern": "^[a-fA-F0-9]{64}$" }
        }
      }
    },
    "training_stages": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["type"],
        "properties": {
          "type": {
            "enum": ["continued_pretraining", "sft", "preference", "merge", "quantization"]
          },
          "config_ref": { "type": "string", "maxLength": 240 },
          "seed": { "type": "integer" }
        }
      }
    },
    "adapters": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "version", "sha256"],
        "properties": {
          "name": { "type": "string", "minLength": 1, "maxLength": 160 },
          "version": { "type": "string", "minLength": 1, "maxLength": 80 },
          "sha256": { "type": "string", "pattern": "^[a-fA-F0-9]{64}$" }
        }
      }
    },
    "evaluations": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["suite", "version", "score", "result_sha256"],
        "properties": {
          "suite": { "type": "string", "minLength": 1, "maxLength": 160 },
          "version": { "type": "string", "minLength": 1, "maxLength": 80 },
          "score": { "type": "number", "minimum": 0, "maximum": 1 },
          "result_sha256": { "type": "string", "pattern": "^[a-fA-F0-9]{64}$" }
        }
      }
    },
    "hashes": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sha256"],
      "properties": {
        "sha256": { "type": "string", "pattern": "^[a-fA-F0-9]{64}$" }
      }
    },
    "created_by": { "const": "SCamposs" },
    "created_at": { "type": "string", "format": "date-time" }
  }
}
