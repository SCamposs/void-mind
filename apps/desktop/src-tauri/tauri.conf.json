{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "VOID Mind",
  "version": "0.2.0-0",
  "identifier": "com.void.mind",
  "build": {
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist",
    "devUrl": "http://127.0.0.1:5174"
  },
  "app": {
    "security": {
      "csp": {
        "default-src": "'self' customprotocol: asset:",
        "connect-src": "ipc: http://ipc.localhost http://127.0.0.1:* http://localhost:*",
        "img-src": "'self' asset: http://asset.localhost blob: data:",
        "style-src": "'self' 'unsafe-inline'",
        "script-src": "'self'"
      },
      "capabilities": ["main"]
    },
    "windows": [
      {
        "title": "VOID Mind",
        "width": 1280,
        "height": 800,
        "minWidth": 720,
        "minHeight": 560,
        "resizable": true,
        "backgroundColor": "#000000"
      }
    ]
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "publisher": "SCamposs",
    "shortDescription": "A standalone intelligence environment for focused conversations and contextual work.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installerIcon": "icons/icon.ico",
        "uninstallerIcon": "icons/icon.ico"
      }
    }
  }
}
