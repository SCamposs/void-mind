{
  "name": "void-mind",
  "private": true,
  "version": "0.2.0-alpha.2",
  "type": "module",
  "workspaces": ["apps/*", "packages/*"],
  "scripts": {
    "dev": "npm run dev --workspace @void-mind/desktop",
